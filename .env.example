# Proactive Financial Agent – Environment Variables
# Copy this file to .env in the same directory (project root) and fill in values.
# Do not commit .env. See README for setup: Supabase (database) and Qdrant (vector store).

# ---- Auth mode (fail closed) ----
# required (default): the API refuses to start unless Supabase auth is
#   configured below, and every request needs a Supabase bearer token.
# demo: anonymous access into a single shared demo workspace. Local dev and
#   previews only — the app refuses to boot with AUTH_MODE=demo in production.
AUTH_MODE=demo

# ---- Shared access code (front-door gate for public demos) ----
# NOT authentication — a single shared secret checked on every /api/* request
# (X-Access-Code header) so a public demo-mode URL can't be hit freely by anyone
# who finds it. Unset = gate disabled (local dev / tests). Strongly recommended
# whenever AUTH_MODE=demo is exposed publicly.
# ACCESS_CODE=

# ---- Database (Supabase PostgreSQL) ----
# Get this from: Supabase Dashboard → Project Settings → Database → Connection string.
# Use "Connection pooling" (Transaction mode), URI format. Replace [YOUR-PASSWORD] with your DB password.
# Example (pooler): postgresql://postgres.PROJECT_REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
#
# Production runs as the least-privilege, RLS-enforced role:
#   DATABASE_URL       -> kritifin_app role (runtime; created by migration 0006,
#                         enable login with: ALTER ROLE kritifin_app LOGIN PASSWORD '...')
#   DATABASE_ADMIN_URL -> postgres role (Alembic migrations + break-glass only)
# For local dev it is fine to point both at the same postgres URL.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# DATABASE_ADMIN_URL=

# ---- Vector store (Qdrant) ----
# Qdrant Cloud: Dashboard → your cluster → "Details" → copy "Cluster URL".
# Local: use http://localhost:6333 (no API key).
QDRANT_URL=https://your-cluster-id.aws.cloud.qdrant.io
# Qdrant Cloud: Dashboard → API Keys → create key. Leave empty for local Qdrant.
QDRANT_API_KEY=

# ---- LLM gateway (document extraction, chat, agents, draft emails) ----
# Completions route through a quota-aware multi-provider gateway
# (app/services/model_gateway.py). Set ANY ONE of the keys below and the app
# works; set several and the gateway routes each purpose to the best free
# option with quota remaining, falling down a chain on 429s/outages.
#
# Free tiers (recommended — the whole app can run on these at $0):
# Groq: https://console.groq.com/keys  (Llama 3.3 70B, Kimi K2, GPT-OSS-120B, Whisper)
GROQ_API_KEY=
# Cerebras: https://cloud.cerebras.ai  (Llama, GPT-OSS; 14,400 req/day free)
CEREBRAS_API_KEY=
# Google AI Studio: https://aistudio.google.com/apikey  (Gemini Flash, 1M context)
GEMINI_API_KEY=
# GOOGLE_API_KEY=   # legacy alias for GEMINI_API_KEY
# Moonshot (Kimi first-party; China-hosted — demo data only): https://platform.moonshot.ai
# MOONSHOT_API_KEY=
# OpenRouter (:free pool; 50 req/day, 1000/day after a one-time $10):
# OPENROUTER_API_KEY=
# OPENROUTER_UNLOCKED=false   # set true after the one-time $10 credit purchase
#
# Paid break-glass options (only used when a key is deliberately set):
# DeepSeek (V4 Flash ~$0.14/$0.28 per M tokens): https://platform.deepseek.com
# DEEPSEEK_API_KEY=
# OpenAI (optional plug-in; also still required for embeddings until the
# fastembed migration): https://platform.openai.com/api-keys
OPENAI_API_KEY=
#
# Optional pins/overrides (default: route by purpose across free tiers):
# LLM_MODEL=            # pin one model for chat/extraction (e.g. gpt-4o-mini)
# BRIEF_LLM_MODEL=      # pin for pre-meeting briefs
# DRAFT_LLM_MODEL=      # pin for draft emails
# LLM_ROUTE_CHAT=       # full route override, comma-separated catalog keys
#                       # e.g. groq:llama-3.3-70b,gemini:flash,openai:gpt-4o-mini
# LLM_QUOTA_BACKEND=postgres   # postgres (default) or memory (tests/dev)
# Sampling temperature for all LLM calls (default 0 = deterministic)
# LLM_TEMPERATURE=0
# Per-request provider timeout (bounded so a hung call cannot exhaust a
# Lambda invocation; API cap 180s).
# LLM_TIMEOUT_SECONDS=60

# ---- Embeddings (RAG / AI Copilot) ----
# Default: fastembed — bge-small-en-v1.5 runs locally in-process (ONNX, CPU,
# 384 dims). No API key, no rate limits, $0; document text never leaves the
# backend for embedding. Collection defaults to proactive_jarvis_agent_client_memory.
# EMBEDDINGS_PROVIDER=fastembed
# FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
# FASTEMBED_CACHE_DIR=      # model cache override (Docker bakes /opt/fastembed-cache)
#
# Legacy: OpenAI embeddings (1536 dims, client_memory collection). Requires
# OPENAI_API_KEY and `pip install openai`. Migrate existing documents with
# scripts/reindex_embeddings.py.
# EMBEDDINGS_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
#
# Minimum vector-similarity score for a chunk to be used as RAG context (0-1).
# RAG_MIN_SCORE=0.32

# ---- Supabase auth (required unless AUTH_MODE=demo) ----
# SUPABASE_URL verifies modern asymmetric (ES256/RS256) tokens via the project
# JWKS; SUPABASE_JWT_SECRET verifies legacy HS256 tokens. Set whichever your
# project issues (newer projects use asymmetric — set SUPABASE_URL).
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_JWT_SECRET=  # Dashboard → Project Settings → API → JWT Secret

# ---- Document storage (Supabase Storage; recommended for any deployment) ----
# Server-side only — NEVER expose the service-role key to the browser.
# Without it, uploads fall back to backend/uploads/ on local disk, which is
# EPHEMERAL on Lambda/containers (originals are lost on every deploy).
# SUPABASE_SERVICE_ROLE_KEY=   # Dashboard → Project Settings → API → service_role
# STORAGE_BUCKET=documents

# ---- Observability ----
# Sentry error reporting (backend). No-op when unset.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Langfuse LLM tracing (Cloud Hobby tier is free: 50k observations/month).
# Traces every gateway call and agent run (steps, models, token usage).
# No-op when unset. https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# Set true to send only lengths/metadata (no prompt/output content) — the
# setting for real client books; demo/mock data can stay unmasked.
# LANGFUSE_MASK_CONTENT=false
# Release tag for Sentry (CI sets this to the git SHA).
# RELEASE_SHA=
# Log output: json (default; production) or text (friendlier local dev).
# LOG_FORMAT=text
# Logging verbosity: DEBUG, INFO, WARNING, ERROR (default INFO).
# LOG_LEVEL=INFO

# ---- Background worker ----
# Queued ingestion jobs are drained event-driven right after each upload:
# locally as an in-process background task (leave this unset), on AWS by
# asynchronously invoking the worker Lambda named here (set by the SAM
# template — see deploy/aws/template.yaml). No polling loop either way.
# WORKER_FUNCTION_NAME=

# ---- App (optional) ----
# Qdrant collection name. Defaults to proactive_jarvis_agent_client_memory
# (fastembed, 384-dim); set explicitly to pin the same name in every env:
QDRANT_COLLECTION=proactive_jarvis_agent_client_memory

# ---- API server (optional) ----
# Comma-separated CORS origins (default: http://localhost:3000)
# CORS_ORIGINS=http://localhost:3000
# Optional service-to-service credential (scripts, uptime probes). Requests
# with header `X-API-Key: <this value>` act on SERVICE_ORG_ID's workspace.
# Never shipped to the browser.
# API_KEY=
# SERVICE_ORG_ID=00000000-0000-0000-0000-000000000001
# Destructive data reset (POST /api/settings/clear-data) is disabled unless
# true; in production only the explicit value `force` enables it.
# ALLOW_DATA_RESET=false
# Max upload size in bytes (default 20 MB).
# MAX_UPLOAD_BYTES=20971520
# Finite lifetime AI credits. Balances never reset or renew automatically.
# Existing accounts keep their stored allocation if this default changes.
# DEFAULT_LIFETIME_CREDITS=50
# CREDIT_CONTACT_EMAIL=hello@example.com
# CREDIT_REQUEST_ENABLED=true
# Public "Contact us" chat widget (frontend) -> POST /api/contact (backend).
# Sends via SMTP; the settings below are Zoho Mail's, but any SMTP-over-SSL
# (implicit TLS, typically port 465) provider works. Disabled (503) unless
# all four are set. Get host/port from your provider -> Mail Accounts ->
# IMAP/SMTP details.
# CONTACT_ENABLED=true
# ZOHO_SMTP_HOST=smtp.zoho.in
# ZOHO_SMTP_PORT=465
# ZOHO_SMTP_USER=you@yourdomain.com
# ZOHO_SMTP_PASS=your-smtp-password-or-app-password
# Inbox that receives submissions; From address the message is sent as
# (often the same mailbox as ZOHO_SMTP_USER).
# CONTACT_TO_EMAIL=support@yourdomain.com
# CONTACT_FROM_EMAIL=you@yourdomain.com
# Per-minute rate limits remain an abuse guard, separate from lifetime credits.
# Set RATE_LIMIT_ENABLED=false to disable those limits (tests only).
# Connection pool bounds (tune against your Supabase pooler limits).
# DB_POOL_MIN=2
# DB_POOL_MAX=20
# Validate pooled connections idle longer than this before reuse (seconds).
# DB_IDLE_PING_SECONDS=30

# ---- Compliance posture reporting (shown at /api/compliance/posture) ----
# DATA_RESIDENCY=UK
# DATA_RETENTION_DAYS=2190   # 6 years, aligned with FCA record-keeping norms
# ENCRYPTION_AT_REST=true
# ENCRYPTION_IN_TRANSIT=true

# ---- Frontend (optional — set in frontend/.env.local or Vercel) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sentry for the web app (optional):
# NEXT_PUBLIC_SENTRY_DSN=
