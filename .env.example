# =============================================================================
# Proactive Financial Agent – Environment Variables
# Copy this file to .env in the same directory (project root) and fill in values.
# Do not commit .env. See README for setup: Supabase (database) and Qdrant (vector store).
# =============================================================================

# ---- Database (Supabase PostgreSQL) ----
# Get this from: Supabase Dashboard → Project Settings → Database → Connection string.
# Use "Connection pooling" (Transaction mode), URI format. Replace [YOUR-PASSWORD] with your DB password.
# Example (pooler): postgresql://postgres.PROJECT_REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ---- Vector store (Qdrant) ----
# Qdrant Cloud: Dashboard → your cluster → "Details" → copy "Cluster URL".
# Local: use http://localhost:6333 (no API key).
QDRANT_URL=https://your-cluster-id.aws.cloud.qdrant.io
# Qdrant Cloud: Dashboard → API Keys → create key. Leave empty for local Qdrant.
QDRANT_API_KEY=

# ---- LLM (document extraction, chat, draft emails) ----
# openai (default) or gemini
LLM_PROVIDER=openai
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Optional model override (default: gpt-4o)
# LLM_MODEL=gpt-4o
# Lighter model for pre-meeting briefs (default: gpt-4o-mini)
# BRIEF_LLM_MODEL=gpt-4o-mini

# If using Gemini: set one of these and LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# ---- Embeddings (RAG / Ask Jarvis) ----
# openai (default), cohere, or gemini. Must match 1536-dim if using default Qdrant collection.
EMBEDDING_PROVIDER=openai
# OpenAI text-embedding-3-small = 1536 dimensions (required for create_qdrant_collection.py)
EMBEDDING_MODEL=text-embedding-3-small
# COHERE_API_KEY=  # if EMBEDDING_PROVIDER=cohere

# ---- App (optional) ----
# Qdrant collection name (default: client_memory)
# QDRANT_COLLECTION=client_memory
# UUID to attach to newly ingested clients
# ADVISER_ID=00000000-0000-0000-0000-000000000001

# ---- API server (optional) ----
# Comma-separated CORS origins (default: http://localhost:3000)
# CORS_ORIGINS=http://localhost:3000

# ---- Security (M0 stopgap; see IMPLEMENTATION_PLAN.md M1 for full auth) ----
# If set, every /api/* request must send header `X-API-Key: <this value>`.
# Leave unset for local dev (the API logs a warning that it is unauthenticated).
# API_KEY=
# Destructive data reset (POST /api/settings/clear-data) is disabled unless true.
# ALLOW_DATA_RESET=false
# Max upload size in bytes (default 20 MB).
# MAX_UPLOAD_BYTES=20971520
# Logging verbosity: DEBUG, INFO, WARNING, ERROR (default INFO).
# LOG_LEVEL=INFO

# ---- Frontend (optional) ----
# If the backend API_KEY is set, the web app forwards this as X-API-Key.
# Set in Vercel/Next env, not here. NEXT_PUBLIC_API_KEY=
