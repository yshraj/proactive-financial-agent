# KritiFin — PRODUCTION / VM deployment env template.
#
# Copy to `.env` next to docker-compose.yml and fill in real values:
#     cp .env.production.example .env
# `.env` is gitignored — never commit it. The backend logs a warning at startup
# naming any expected var left unset (see app.observability.startup_config_warnings).
#
# This template targets the Dockerized demo VM: gated demo mode, containerized
# Qdrant, external Supabase Postgres. For full local-dev options see .env.example.

# ---- Runtime posture ----
# Marks the environment (Sentry tag, prod guards). Use "staging" or "demo" for a
# gated demo box. IMPORTANT: AUTH_MODE=demo is REFUSED when ENV=production, so do
# NOT set ENV=production for a demo-mode deploy.
ENV=demo

# ---- Front door (auth mode + access code) ----
# demo: anonymous access into one shared workspace, gated by ACCESS_CODE.
# required: every request needs a Supabase JWT (configure SUPABASE_* below).
AUTH_MODE=demo
# REQUIRED for a public demo: the shared code checked on every /api request.
# Without it, AUTH_MODE=demo serves the API to anyone with the URL.
ACCESS_CODE=change-me-to-a-long-random-string

# ---- Database (Supabase Postgres — external) ----
# Runtime connection (least-privilege kritifin_app role in production).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
# Admin connection used ONLY for `alembic upgrade head` (postgres/owner role).
# May equal DATABASE_URL for single-role setups.
DATABASE_ADMIN_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

# ---- Vector store (Qdrant Cloud — external) ----
# Cluster URL from cloud.qdrant.io -> your cluster -> Details -> Cluster URL.
QDRANT_URL=https://your-cluster-id.aws.cloud.qdrant.io
# API key from the Qdrant Cloud dashboard (required for Qdrant Cloud).
QDRANT_API_KEY=your-qdrant-api-key
# Collection name (default: proactive_jarvis_agent_client_memory). Create it
# once with scripts/create_qdrant_collection.py (see DEPLOY.md).
# QDRANT_COLLECTION=proactive_jarvis_agent_client_memory

# ---- LLM + embeddings ----
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
# Per-request OpenAI timeout/retries (defaults: 60s, 1 retry) — bounded so a
# hung call cannot exhaust a Lambda invocation or a worker job budget.
# OPENAI_TIMEOUT_SECONDS=60
# OPENAI_MAX_RETRIES=1
EMBEDDING_MODEL=text-embedding-3-small
# If LLM_PROVIDER=gemini instead, set one of these and unset OPENAI_API_KEY:
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# ---- Lifetime AI credits ----
# Finite initial allocation; balances never reset or renew automatically.
DEFAULT_LIFETIME_CREDITS=50
CREDIT_CONTACT_EMAIL=hello@example.com
CREDIT_REQUEST_ENABLED=true

# ---- Contact us / report an issue (public chat widget -> SMTP) ----
# Disabled (503) unless all four SMTP values are set. Any SMTP-over-SSL
# (implicit TLS, typically port 465) provider works — Zoho shown here.
CONTACT_ENABLED=true
ZOHO_SMTP_HOST=smtp.zoho.in
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=you@yourdomain.com
ZOHO_SMTP_PASS=your-smtp-password-or-app-password
CONTACT_TO_EMAIL=support@yourdomain.com
CONTACT_FROM_EMAIL=you@yourdomain.com

# ---- CORS ----
# MUST include the public frontend origin, or the browser blocks API calls.
# Behind the reverse proxy the frontend calls same-origin /api, so list the
# public site URL here. Comma-separated for multiple origins.
CORS_ORIGINS=https://your-domain.example

# ---- Supabase auth (only when AUTH_MODE=required) ----
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_JWT_SECRET=

# ---- Document storage (Supabase Storage; recommended so uploads survive deploys) ----
# Server-side only — never exposed to the browser.
# SUPABASE_SERVICE_ROLE_KEY=
# STORAGE_BUCKET=documents

# ---- Observability ----
# Backend error reporting. Unset = structured stdout logs only (captured by the
# container runtime). LOG_FORMAT=json is recommended in production.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_FORMAT=json
LOG_LEVEL=INFO

# ---- Worker / misc ----
# docker-compose drains queued jobs event-driven, in-process, right after each
# upload (no WORKER_FUNCTION_NAME needed; that's the AWS Lambda deploy knob).
# Destructive data reset stays disabled in production unless explicitly forced.
ALLOW_DATA_RESET=false

# ---- Reverse proxy (Phase 4 / Caddy) ----
# Public domain pointed at the VM; used by Caddy for automatic TLS.
DOMAIN=your-domain.example
# Contact email for the ACME/Let's Encrypt account.
ACME_EMAIL=you@example.com

# ---- Frontend build args (NEXT_PUBLIC_*; inlined at image build time) ----
# Behind Caddy the frontend and API share one origin, so set this to the public
# HTTPS site URL (same as DOMAIN). The browser then calls https://DOMAIN/api,
# which Caddy routes to the backend — same-origin, no CORS preflight.
# NOTE: an empty value falls back to http://localhost:8000 (see lib/api.ts), so
# always set the full URL for a proxied deploy. Proxy-less local compose uses
# http://localhost:8000.
NEXT_PUBLIC_API_URL=https://your-domain.example
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SENTRY_DSN=
