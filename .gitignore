# Environment and secrets (never commit)
.env
.env.local
.env.*.local
# Catch stray/misnamed secret files (e.g. "Proactive Financial Agent.env").
# Does not match *.env.example, which is safe to commit.
*.env
# Editor "unsaved buffer" scratch files at the repo root have no extension
# and so miss the *.env glob above — but have repeatedly been used to paste
# .env content during local setup (observed in this repo: an untracked
# "Untitled" file was a byte-for-byte copy of every secret in .env, one
# `git add .` away from being committed). Never legitimate to commit.
/Untitled
/Untitled.*
/Untitled *

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
ENV/

# Backend uploads (ingested files – keep folder via .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep

# Generated eval reports (backend/evals/run_evals.py)
backend/evals/report/

# Node / Frontend
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
*.tsbuildinfo

# IDE and OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# AI-assistant tooling (local skills/config; not part of the product)
.agents/
.claude/
.cursor/
skills-lock.json

# Logs and temp
*.log
*.tmp
.cache/

# Playwright e2e artifacts
frontend/test-results/
frontend/playwright-report/
frontend/playwright-results/
frontend/blob-report/
frontend/.cache/
frontend/tests/.auth/

# Local pyc cache used during validation
backend/.pycache/

# Test coverage artifacts
backend/.coverage
backend/coverage.xml
backend/htmlcov/

# Embedded local Postgres for development (scripts/local_db.py)
backend/.localdb/

# Local dummy/sample documents for manual testing (not committed)
sample-documents/
