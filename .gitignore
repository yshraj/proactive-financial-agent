# Environment and secrets (never commit)
.env
.env.local
.env.*.local
# Catch stray/misnamed secret files (e.g. "Proactive Financial Agent.env").
# Does not match *.env.example, which is safe to commit.
*.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
ENV/

# Backend uploads (ingested files – keep folder via .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep

# Node / Frontend
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
*.tsbuildinfo

# IDE and OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Logs and temp
*.log
*.tmp
.cache/

# Playwright e2e artifacts
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/.cache/

# Local pyc cache used during validation
backend/.pycache/
