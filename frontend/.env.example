# Frontend – Environment Variables
# Copy to .env.local for local development. Do not commit .env.local.
# For production (e.g. Vercel), set NEXT_PUBLIC_API_URL in the hosting dashboard.

# Backend API base URL (no trailing slash).
# Local: http://localhost:8000
# Production: your deployed backend URL, e.g. https://your-app.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000
