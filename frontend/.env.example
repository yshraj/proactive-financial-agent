# Frontend – Environment Variables
# Copy to .env.local for local development. Do not commit .env.local.
# For production (e.g. Vercel), set NEXT_PUBLIC_API_URL in the hosting dashboard.

# Backend API base URL (no trailing slash).
# Local: http://localhost:8000
# Production: your deployed backend URL, e.g. https://your-app.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- SEO ----
# Canonical site origin used for <link rel="canonical">, Open Graph URLs,
# robots.txt and sitemap.xml. Set this to your production domain.
# NEXT_PUBLIC_SITE_URL=https://app.jarvis.com

# ---- Supabase Auth (optional) ----
# When both are set, /login and /signup authenticate and protected routes
# require a session. When unset, the app runs unauthenticated (auth UI offers
# a "Continue to the app" link and route guards are inert).
# Supabase Dashboard → Project Settings → API.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
