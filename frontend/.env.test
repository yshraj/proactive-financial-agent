# Playwright E2E defaults.
# Override these in CI or when targeting a deployed environment.

PLAYWRIGHT_BASE_URL=http://localhost:3000
PLAYWRIGHT_API_URL=http://localhost:8000

# Set to true when testing an already-running local or deployed app.
E2E_SKIP_WEBSERVER=false

# Optional: only required when the target environment has Supabase auth enabled.
E2E_EMAIL=
E2E_PASSWORD=
